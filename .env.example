# Copy to .env and fill in. See README for where each value comes from.

# --- Leaguepedia -----------------------------------------------------------
# Create a bot password at lol.fandom.com/wiki/Special:BotPasswords (tick
# "Basic rights"). The confirmation page shows "YourName@botname" and a 32-char
# token, and the two have to be split across these variables.
#
# The bot name belongs in the PASSWORD, in front of the token. Putting the bare
# token here with a plain username fails with "credentials could not be
# authenticated", which does not hint at the real cause.
WIKI_USERNAME_ME=YourFandomName
WIKI_PASSWORD_ME=yourbotname@thirtytwocharactertoken

# --- Which tournament ------------------------------------------------------
# These name the same event but are not interchangeable: ScoreboardGames keys
# on Tournament, MatchSchedule has no such column and keys on OverviewPage.
page_to_query=Worlds 2025 Main Event
overview_page=2025 Season World Championship/Main Event

# --- Discord ---------------------------------------------------------------
client_run_key=
# A server id. Commands sync to one guild instantly; globally it can take an hour.
TEST_GUILD_ID=

# --- /lina -----------------------------------------------------------------
# console.anthropic.com. Billed per token, separate from any Claude subscription.
ANTHROPIC_API_KEY=
LINA_MODEL=claude-haiku-4-5

# --- Legacy /schedule and /standings ---------------------------------------
# Unofficial LoL Esports API. No developer portal: the key is a public constant
# the lolesports.com site itself sends. Read it from DevTools > Network > any
# esports-api request > x-api-key.
API_KEY=
worlds_id=98767975604431411
